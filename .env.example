# Токен бота от @BotFather (нужен НОВЫЙ бот — не токен другого работающего бота)
BOT_TOKEN=123456789:AAAA-your-token-here

# Telegram ID админов через запятую (узнать: @userinfobot). Только они управляют ботом.
ADMIN_IDS=123456789,987654321

# Часовой пояс по умолчанию (потом можно поменять в настройках бота)
TIMEZONE=Europe/Moscow

# Где хранить базу данных
DB_PATH=data/autopost.db

# Подробность логов: DEBUG, INFO, WARNING
LOG_LEVEL=INFO
