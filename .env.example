# Токен бота от @BotFather
BOT_TOKEN=123456789:AAAA-your-token-here

# Ваш Telegram ID (узнать: @userinfobot). Только этот человек управляет ботом.
ADMIN_ID=123456789

# Часовой пояс по умолчанию (потом можно поменять в настройках бота)
TIMEZONE=Europe/Moscow

# Где хранить базу данных
DB_PATH=data/autopost.db

# Подробность логов: DEBUG, INFO, WARNING
LOG_LEVEL=INFO
